# ========================================================
# OpenCode Configuration (Zen / Go models)
# ========================================================
# Pick ONE of the two setups below and delete/comment out the other. Both blocks
# define the same variable names, and the last definition wins — leaving both
# active silently points the tool at the local bridge.

# --------------------------------------------------------
# Setup A — DIRECT gateway (simplest)
# --------------------------------------------------------
# Your OpenCode API key (starts with sk-...)
OPENCODE_API_KEY=""

# Which gateway to use. Zen and Go have SEPARATE model catalogues.
#   Zen (pay-as-you-go) : https://opencode.ai/zen/v1      <- free models live here
#   Go  (subscription)  : https://opencode.ai/zen/go/v1
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# The model you wish to use. Must exist on the gateway chosen above.
# Paid Zen options : deepseek-v4.1-flash, deepseek-v4-pro, glm-5.3, kimi-k3, qwen3.8-max
# Free Zen options : deepseek-v4-flash-free, mimo-v2.6-flash-free,
#                    longcat-2.5-preview-free, nemotron-3-ultra-free
# NOTE: free '*--free' IDs reject DIRECT calls (HTTP 403) — they need Setup B.
#
# Run `python main.py --list-models` to see what your key can actually use.
OPENCODE_MODEL="deepseek-v4.1-flash"

# --------------------------------------------------------
# Setup B — free Zen models through the local bridge
# --------------------------------------------------------
# Zen's free tier requires a session header that only the official CLI sets, so
# free models have to be reached through the bridge. Start it first:
#
#   1) python run_opencode_bridge.py
#   2) copy the token it prints into OPENCODE_API_KEY below
#   3) python main.py "article.pdf" --provider opencode
#
# The bridge requires that token on every request. These three lines stay
# COMMENTED OUT until you actually run the bridge — otherwise every run fails
# with "connection refused", or a 401 from the bridge.
#
# OPENCODE_API_KEY="<token printed by run_opencode_bridge.py>"
# OPENCODE_BASE_URL="http://127.0.0.1:4097/v1"
# OPENCODE_MODEL="mimo-v2.6-flash-free"

# ========================================================
# Other Providers (Optional)
# ========================================================
# Google Gemini API Key
GEMINI_API_KEY=""

# Optional custom Gemini endpoint (proxy or compatible gateway).
# Leave blank to use the official Google endpoint.
GEMINI_BASE_URL=""

# OpenAI API Key
OPENAI_API_KEY=""

# Optional custom OpenAI-compatible endpoint (proxy, Azure gateway, Ollama, etc.).
# Leave blank to use the official OpenAI endpoint.
OPENAI_BASE_URL=""
